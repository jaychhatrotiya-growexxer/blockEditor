{
  "name": "backend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "node --watch src/server.js",
    "build": "echo 'Building backend...'",
    "start": "node src/server.js",
    "prisma:validate": "set -a && . ../.env && set +a && prisma validate --schema prisma/schema.prisma",
    "prisma:generate": "set -a && . ../.env && set +a && prisma generate --schema prisma/schema.prisma",
    "migrate": "set -a && . ../.env && set +a && prisma migrate dev --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "prisma": "^6.7.0"
  }
}
