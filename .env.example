REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=blocknote_refresh_token
SHARE_TOKEN_SECRET=replace-with-another-long-random-string
BCRYPT_SALT_ROUNDS=12
